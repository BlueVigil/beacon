#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only

set -euo pipefail

target="${1:?usage: scripts/bundle-linux <target-triple>}"

case "${target}" in
  aarch64-*|arm64-*) arch="aarch64" ;;
  x86_64-*) arch="x86_64" ;;
  *) printf 'unsupported target: %s\n' "${target}" >&2; exit 1 ;;
esac

host_arch="$(dpkg --print-architecture)"

if [[ "${arch}" == "aarch64" && "${host_arch}" == "amd64" ]]; then
  dpkg --add-architecture arm64
  apt_suffix=":arm64"
  cross_prefix="aarch64-linux-gnu-"
else
  apt_suffix=""
  cross_prefix=""
fi

sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
  "libudev-dev${apt_suffix}" \
  "libxcb1-dev${apt_suffix}" \
  "libxcb-render0-dev${apt_suffix}" \
  "libxcb-shape0-dev${apt_suffix}" \
  "libxcb-xfixes0-dev${apt_suffix}" \
  "libxkbcommon-dev${apt_suffix}" \
  "libxkbcommon-x11-dev${apt_suffix}" \
  "libasound2-dev${apt_suffix}" \
  "libfontconfig-dev${apt_suffix}" \
  "libfreetype-dev${apt_suffix}" \
  file

rustup target add "${target}" 2>/dev/null || true
cargo build --release --target "${target}"

binary="target/${target}/release/beacon"
[[ -f "${binary}" ]] || { printf 'binary not found: %s\n' "${binary}" >&2; exit 1; }
"${cross_prefix}strip" "${binary}"

appdir="target/dist/BEACON.AppDir"
rm -rf target/dist linuxdeploy BEACON-*.AppImage
mkdir -p "${appdir}/usr/bin/resources" "${appdir}/usr/lib" "${appdir}/usr/share"

cp "${binary}" "${appdir}/usr/bin/beacon"
chmod +x "${appdir}/usr/bin/beacon"
cp -R assets "${appdir}/usr/bin/resources/assets"

mkdir -p "${appdir}/usr/share/applications" "${appdir}/usr/share/icons/hicolor/512x512/apps"
cp assets/icons/beacon.png "${appdir}/usr/share/icons/hicolor/512x512/apps/dev.beacon.BEACON.png"

cat > "${appdir}/dev.beacon.BEACON.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=BEACON
Comment=Flash Teensy firmware
Exec=beacon %f
Icon=dev.beacon.BEACON
Terminal=false
Categories=Development;Electronics;
MimeType=application/x-intel-hex;text/x-hex;
DESKTOP

cp "${appdir}/usr/share/icons/hicolor/512x512/apps/dev.beacon.BEACON.png" "${appdir}/dev.beacon.BEACON.png"

cat > "${appdir}/AppRun" <<'APPRUN'
#!/bin/sh
SELF="$(readlink -f "$0")"
HERE="${SELF%/*}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH:-}"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec "${HERE}/usr/bin/beacon" "$@"
APPRUN
chmod +x "${appdir}/AppRun"

if [[ "${arch}" == "aarch64" ]]; then
  linuxdeploy_arch="aarch64"
else
  linuxdeploy_arch="x86_64"
fi

curl -fSL -o linuxdeploy "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-${linuxdeploy_arch}.AppImage"
chmod +x linuxdeploy

./linuxdeploy --appdir "${appdir}" --output appimage

mv BEACON-*.AppImage "target/dist/BEACON-linux-${arch}.AppImage"

printf 'created target/dist/BEACON-linux-%s.AppImage\n' "${arch}"
